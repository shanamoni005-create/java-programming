interface SmartDevice {
    void operate();
}

class SmartLight implements SmartDevice, Runnable {

    public void operate() {
        for (int i = 1; i <= 3; i++) {
            System.out.println("Light: Blinking cycle " + i);

            try {
                Thread.sleep(500);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        }
    }

    public void run() {
        operate();
    }
}

class SmartFan implements SmartDevice, Runnable {

    public void operate() {
        for (int i = 1; i <= 3; i++) {
            System.out.println("Fan: Rotating at speed level " + i);

            try {
                Thread.sleep(500);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        }
    }

    public void run() {
        operate();
    }
}

class SmartAC implements SmartDevice, Runnable {

    public void operate() {
        for (int i = 1; i <= 3; i++) {
            System.out.println("AC: Cooling, temperature step " + i);

            try {
                Thread.sleep(500);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        }
    }

    public void run() {
        operate();
    }
}

public class SmartHomeDemo {
    public static void main(String[] args) {

        Thread lightThread = new Thread(new SmartLight());
        Thread fanThread = new Thread(new SmartFan());
        Thread acThread = new Thread(new SmartAC());

        lightThread.start();
        fanThread.start();
        acThread.start();
    }
}




